# Ear Warrior backend configuration.
# Copy to .env and adjust. docker-compose.yml provides a matching local Postgres.

# Postgres connection string. Matches the docker-compose service below.
DATABASE_URL=postgres://ear_warrior:ear_warrior@localhost:5432/ear_warrior

# HTTP port the Fastify server listens on.
PORT=8080

# Comma-separated list of allowed CORS origins for the landing page / dev client.
# Use * only for local development.
CORS_ORIGIN=*

# --- Social analytics dashboard (GET /admin/social) -------------------------------------------
# The page is disabled (404) until ADMIN_PASSWORD is set. Basic auth, user = ADMIN_USER.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Run the collectors inside the server every N hours (0 / unset = only via `npm run collect`
# or POST /admin/social/collect from an external scheduler).
SOCIAL_COLLECT_INTERVAL_HOURS=0

# YouTube: Google Cloud OAuth client + a refresh token for the channel owner
# (scopes: youtube.readonly, yt-analytics.readonly). See README "Social analytics".
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Instagram (Instagram API with Instagram Login): a long-lived token for the Business account.
# Only seeds the first run — after that the refreshed token lives in the database.
IG_ACCESS_TOKEN=

# --- Vercel deployment -------------------------------------------------------------------------
# Vercel Cron calls GET /api/cron/social with `Authorization: Bearer $CRON_SECRET`; unset = route is 404.
CRON_SECRET=
# Serverless: one connection per instance; Neon's pooled URL needs prepared statements off.
DB_POOL_MAX=10
DB_PREPARE=true
