{
  "name": "ear-warrior-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ear Warrior backend — Fastify + Drizzle + Postgres (telemetry, waitlist signups, and durable game-history sync). Replaces Supabase.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
